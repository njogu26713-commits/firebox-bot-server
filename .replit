modules = ["nodejs-20"]

[nix]
channel = "stable-25_05"
packages = ["ffmpeg", "imagemagick", "libwebp", "yt-dlp"]

[agent]
expertMode = true

[deployment]
deploymentTarget = "vm"
run = ["npm", "start"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Firebox Backend"

[[workflows.workflow]]
name = "Firebox Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
